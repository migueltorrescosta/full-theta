# c2: Tactical after c1, then Ops.
connect
expect_welcome resumed=false
await name=c1_tactical
pick ship=0 entry=tactical
barrier name=picked n=3
expect_event type=lobby payload.ship=0 payload.uncovered~=relay payload.uncovered~=comms keep=true
# c1 holds mount 0: c2's command on it is rejected and c2 sees who holds it.
command id=aim kind=aim_mount mount_index=0 aim_x=0.0 aim_y=0.0 aim_z=100.0
expect_rejected id=aim reason=claimed
expect_view ownership.claims.mount:0.1=c1
barrier name=rejected n=3
barrier name=released n=3
claim item=mount:0
expect_event type=claim payload.item=mount:0 payload.name=c2
command id=aim2 kind=aim_mount mount_index=0 aim_x=0.0 aim_y=0.0 aim_z=100.0
expect_accepted id=aim2
barrier name=c2_claimed n=3
barrier name=checked n=3
pick ship=0 entry=ops
barrier name=covered n=3
expect_event type=started payload.ship=0
barrier name=started n=3
# c1 crashes and comes back within the grace: no pause, snapshots never stop.
mark
await name=c1_back timeout=60
expect_no_event type=pause for=0.1
expect_flowing max_gap_ms=1000
barrier name=rejoined n=3
mark
expect_event type=pause payload.ship=0 payload.uncovered~=engineering timeout=40
expect_tick_still for=1
expect_flowing max_gap_ms=1000
barrier name=paused n=2
expect_event type=resume timeout=40
expect_tick_moving
barrier name=done n=3
bye
