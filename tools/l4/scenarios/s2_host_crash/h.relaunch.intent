# h relaunched: the orphan check offers to rejoin (a session is active and the token
# names its port); it rejoins on the same ship and pick as the host (TECH-8).
orphan_rejoin pid_file=$RUN/server.pid.json expect=offer_rejoin timeout=20  # B2: session_active in the pid file
connect
expect_welcome resumed=true ship=0 entry=p2
expect_view stats.fulls>=1 blocks.helm.decoupled=true
expect_tick_moving
signal name=h_back
barrier name=done n=3
# Leaving as the host ends the session: stop the server.
bye
host_stop pid_file=$RUN/server.pid.json
