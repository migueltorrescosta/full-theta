# h: the host client. Spawns the server child, joins as host, picks Tactical.
host_spawn port=$PORT pid_file=$RUN/server.pid.json publish=url timeout=30  # B2: host entry
connect
expect_welcome resumed=false
pick ship=0 entry=p2
barrier name=picked n=3
ready
expect_event type=started  # A: run start event
expect_tick_moving
barrier name=started n=3
command id=go kind=helm_input throttle=1.0 rotation=Vector3(0, 0.2, 0)
expect_accepted id=go
command id=helm kind=helm_decoupled decoupled=true
expect_accepted id=helm
expect_view blocks.helm.decoupled=true
signal name=h_kill
await name=never timeout=60
