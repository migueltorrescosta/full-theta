# c2: crew on the hosted server (systems); keeps playing while the host crashes.
connect
expect_welcome resumed=false host=false
pick ship=0 entry=systems
barrier name=picked n=3
expect_event type=started payload.ship=0
barrier name=started n=3
mark
await name=h_back timeout=60
# Snapshots never stopped while the host was down (TECH-8).
expect_flowing max_gap_ms=1000
expect_no_event type=pause for=0.1
expect_tick_moving
barrier name=done n=3
bye
barrier name=left n=3
