[resource]
script = ExtResource("1_map")
id = &"m3_map"
period_m = 400000.0
sites = Array[ExtResource("2_site")]([SubResource("Resource_kestrel_yard"), SubResource("Resource_vesper_beacon"), SubResource("Resource_cinder_field"), SubResource("Resource_pale_drift"), SubResource("Resource_anchorage_nine"), SubResource("Resource_hollow_gate")])
