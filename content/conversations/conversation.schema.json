{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/migueltorrescosta/full-theta/content/conversations/conversation.schema.json",
  "title": "Full Theta conversation (FT-DAT-003, FT-COM-007)",
  "description": "A Comms conversation: a graph of nodes, each an NPC line (a dialogue line id) with structured reply options, never free text. tools/check_dialogue.py also checks what a schema can't: every line and text key exists, every next and start names a node, every node is reachable, and every rep names a reputation distribution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "npc_role", "start", "nodes"],
  "properties": {
    "$schema": {"type": "string"},
    "_comment": {"type": "string"},
    "id": {"description": "conv.<file name>.", "type": "string", "pattern": "^conv\\.[a-z][a-z0-9_]*$"},
    "npc_role": {"description": "Voice role of the NPC (content/voices.json).", "enum": ["npc"]},
    "start": {"description": "The node the conversation opens at.", "type": "string"},
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "line_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "options"],
      "properties": {
        "line": {"description": "The NPC's dialogue line id (content/dialogue/*.json).", "$ref": "#/$defs/line_id"},
        "options": {"description": "Replies; none ends the conversation.", "type": "array", "items": {"$ref": "#/$defs/option"}}
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "text": {"description": "UI string key of the reply (content/i18n/strings.json).", "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"},
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scan_fact": {"description": "A fact Science learned about the contact (P14).", "type": "string", "minLength": 1},
            "flag": {"type": "string", "minLength": 1},
            "min": {"type": "integer"},
            "docked": {"type": "boolean"}
          }
        },
        "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "next": {"description": "The node the reply leads to; absent ends the conversation.", "type": "string"}
      }
    },
    "effect": {
      "description": "One effect per object.",
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["accept"], "properties": {"accept": {"const": true}}},
        {"type": "object", "additionalProperties": false, "required": ["decline"], "properties": {"decline": {"const": true}}},
        {"type": "object", "additionalProperties": false, "required": ["intent"], "properties": {"intent": {"enum": ["unknown", "hostile", "neutral", "surrendering", "bluffing"]}}},
        {"type": "object", "additionalProperties": false, "required": ["contract_flag"], "properties": {"contract_flag": {"enum": ["none", "disable", "protect"]}}},
        {"type": "object", "additionalProperties": false, "required": ["flag"], "properties": {"flag": {"type": "string", "minLength": 1}, "value": {"type": "integer"}}},
        {"type": "object", "additionalProperties": false, "required": ["rep"], "properties": {"rep": {"description": "A RepDistDef id (content/economy/rep/).", "type": "string", "pattern": "^rep\\.[a-z0-9_.]+$"}}},
        {"type": "object", "additionalProperties": false, "required": ["say"], "properties": {"say": {"$ref": "#/$defs/line_id"}}},
        {"type": "object", "additionalProperties": false, "required": ["verify"], "properties": {"verify": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["surrender"], "properties": {"surrender": {"description": "Ask the card's contact to surrender (P9): chance = base + per_damage * its engine damage, at most cap, all in [0, 1].", "type": "object", "additionalProperties": false, "required": ["base", "per_damage", "cap"], "properties": {"base": {"type": "number", "minimum": 0, "maximum": 1}, "per_damage": {"type": "number", "minimum": 0, "maximum": 1}, "cap": {"type": "number", "minimum": 0, "maximum": 1}}}}}
      ]
    }
  }
}
